<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 1. The Base Theme (Fixes the Cast Button Crash) -->
    <style name="Theme.YugenPlay" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- These colors prevent the "translucent #0" crash in the Cast button -->
        <item name="colorPrimary">#8B5CF6</item>
        <item name="colorPrimaryDark">#09090B</item>
        <item name="colorAccent">#8B5CF6</item>
    </style>

    <!-- 2. The Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- The dark background color matching your icon -->
        <item name="windowSplashScreenBackground">#0B0B0E</item>

        <!-- The foreground icon we generated -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>

        <!-- Hands control back to the AppCompat theme above when splash finishes -->
        <item name="postSplashScreenTheme">@style/Theme.YugenPlay</item>
    </style>
</resources>