<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude heavy downloaded video files and APK update files from Google Drive cloud quota -->
        <exclude domain="file" path="offline_anime" />
        <exclude domain="file" path="updates" />
        <exclude domain="external" path="updates" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="offline_anime" />
        <exclude domain="file" path="updates" />
        <exclude domain="external" path="updates" />
    </device-transfer>
</data-extraction-rules>